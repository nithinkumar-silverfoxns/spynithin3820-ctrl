# SILVERFOXNS JARVIS — backend environment
# Copy to .env and fill in. NEVER commit the real .env.

# --- App ---
APP_NAME="SILVERFOXNS JARVIS"
ENVIRONMENT=development                 # development | production
DEBUG=true

# --- Database ---
# Production: PostgreSQL. Leave blank to use a local SQLite file (dev/smoke tests only).
# Example: postgresql+psycopg2://jarvis:jarvis@localhost:5432/jarvis
DATABASE_URL=

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15            # short-lived access tokens
REFRESH_TOKEN_TTL_DAYS=30
# Fernet key for encrypting sensitive data at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- OpenAI (server-side only; never shipped to the mobile app) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_VOICE=verse

# --- CORS ---
# Comma-separated origins allowed to call the API (your mobile dev server, etc.)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
